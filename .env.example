# ============================================================================
# .env.example — plantilla de variables de entorno (SIN secretos)
# ============================================================================
# Este archivo SÍ se versiona: es la plantilla que documenta qué variables
# necesita el entorno. El archivo local `.env` (con los valores reales) está
# gitignoreado, y ninguna contraseña debe escribirse jamás en el repositorio
# (regla estricta "configuración no hardcodeada" del README).
#
# Uso antes de correr la capa integral:
#   cp .env.example .env        # y completa los valores reales
#   set -a; source .env; set +a # exporta las variables al shell
#   source ~/.venv/bin/activate
#   python -m pytest tests/integrales -m free -q
#
# Si estas variables no están exportadas, la fixture de connection no se crea y
# las pruebas integrales de connection se SALTAN con el motivo documentado (spec
# `uc-external-object-grants` - "Tipo no creable en ningún perfil"); el resto de
# la suite no se ve afectado.
# ============================================================================

# ----------------------------------------------------------------------------
# Datos del SQL Server de pruebas para la fixture de connection de Unity Catalog
# (change C6 `grants-uc-externos`, capa integral sobre `andresFree`).
# Los consume `tests/integrales/fixtures_uc_externos.py` para emitir el DDL
# `CREATE CONNECTION ... TYPE SQLSERVER OPTIONS (...)`.
# ----------------------------------------------------------------------------
CONTROL_ACCESOS_SQLSERVER_HOST=
CONTROL_ACCESOS_SQLSERVER_PORT=
CONTROL_ACCESOS_SQLSERVER_USER=
CONTROL_ACCESOS_SQLSERVER_PASSWORD=

# ----------------------------------------------------------------------------
# OAuth M2M del service principal ejecutor restringido aprobado por el humano
# (change C8 `grants-apps-tokens`, capa integral de permiso denegado real —
# App Id `1738687d-4838-49ef-83fd-521f935a9ec2`, SIN privilegios
# administrativos sobre los workspaces de prueba).
# Los consume la integral 6.5 de
# `tests/integrales/test_grants_apps_tokens_andresfree.py` para construir un
# `WorkspaceClient` autenticado por OAuth M2M contra `andresFree` y provocar
# un `PERMISSION_DENIED` natural que valide la clasificación
# `privilegios_insuficientes` del canal.
#
# Si la variable no está exportada, la integral 6.5 se salta con motivo
# documentado y el resto de la suite sigue verde.
# ----------------------------------------------------------------------------
CONTROL_ACCESOS_SP_CLIENT_SECRET=
